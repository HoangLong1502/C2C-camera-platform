# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5440
DATABASE_USER=postgres
DATABASE_PASSWORD=12343
DATABASE_NAME=camera_web

# Server Configuration
PORT=3003
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3002

# Public backend URL (used for VNPay return URL)
BACKEND_PUBLIC_URL=http://localhost:3003

# VNPay Configuration (Sandbox)
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_TMN_CODE=your-vnpay-tmn-code
VNP_HASH_SECRET=your-vnpay-hash-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI định giá khi đăng sản phẩm.
# Ưu tiên: nếu có OPENROUTER_API_KEY → gọi OpenRouter. Ngược lại nếu có OPENAI_API_KEY → gọi OpenAI.
# Không có key nào → heuristic nội bộ.
AI_PRICING_ENABLED=true
AI_PRICING_JSON_OBJECT=true

# OpenRouter (https://openrouter.ai/) — model dạng provider/name, ví dụ openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_PRICING_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://localhost:3002
OPENROUTER_APP_TITLE=C2C Camera pricing

# OpenAI trực tiếp (chỉ dùng khi không set OPENROUTER_API_KEY)
OPENAI_API_KEY=
OPENAI_PRICING_MODEL=gpt-4o-mini

# Tự publish sau khi đăng bài (backend create product)
AUTO_APPROVE_ENABLED=true
# true = cần pass moderation rule (tên/mô tả/ảnh...) VÀ AI thấy giá hợp lý.
# false = chỉ cần AI/heuristic thấy giá hợp lý (vẫn bật AUTO_APPROVE_ENABLED) là tự publish.
AUTO_PUBLISH_STRICT_MODERATION=true
