# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5440
DATABASE_USER=postgres
DATABASE_PASSWORD=12343
DATABASE_NAME=camera_web

# Server Configuration
PORT=3003

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

NODE_ENV=development
FRONTEND_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:3003

# AI định giá khi đăng sản phẩm (ưu tiên OpenRouter nếu có OPENROUTER_API_KEY)
AI_PRICING_ENABLED=true
AI_PRICING_JSON_OBJECT=true

OPENROUTER_API_KEY=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
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_PRICING_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://localhost:3002
OPENROUTER_APP_TITLE=C2C Camera pricing

# OpenAI trực tiếp (chỉ dùng khi không set OPENROUTER_API_KEY)
OPENAI_API_KEY=
OPENAI_PRICING_MODEL=gpt-4o-mini

# Tự duyệt bài khi đăng (true/false)
AUTO_APPROVE_ENABLED=true
# false = chỉ cần AI thấy giá hợp lý là tự publish (không chờ đủ điểm moderation rule)
AUTO_PUBLISH_STRICT_MODERATION=false
